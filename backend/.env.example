NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy". Leave false unless a reverse proxy strips client X-Forwarded-For.
# Behind one proxy use 1; on a trusted private network use loopback/linklocal/uniquelocal.
TRUST_PROXY=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusway

# Python FastAPI Dijkstra service (PostgreSQL-backed /api/v1)
ACCESU_NAVIGATION_URL=http://127.0.0.1:8000
# Create with: python ai-service/scripts/api_keys.py create node-backend --permissions navigation:route
# ACCESU_NAVIGATION_API_KEY=accu_<prefix>.<secret>

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Must differ from both JWT secrets (>= 32 characters).
PSEUDONYM_SECRET=replace-with-a-third-32-random-character-secret
MOBILITY_POLICY_VERSION=2026-11-v1

BCRYPT_ROUNDS=11
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Per-IP budget for POST /api/ai/route (each call does Dijkstra + DB work).
AI_RATE_LIMIT_PER_MINUTE=30

# Optional integrations
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# CARTESIA_API_KEY=
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_API_URL=https://api.cartesia.ai
# CARTESIA_VERSION=2026-08-14
# CARTESIA_VOICE_ID=
# CARTESIA_VOICE_ID_AR=
# CARTESIA_VOICE_ID_FR=
# CARTESIA_VOICE_ID_EN=
# CARTESIA_STT_MODEL=ink-2
