{
  "name": "accesu-server",
  "version": "0.1.0",
  "private": true,
  "description": "accesU API — accessible indoor navigation for an Algerian university campus",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-postgis": "0.2.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
