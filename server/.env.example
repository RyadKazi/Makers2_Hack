# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16 + PostGIS) ---
DATABASE_URL=postgresql://campusway:campusway@localhost:5432/campusway?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Short-lived access token (Authorization: Bearer)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (httpOnly cookie), separate secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-of-32-chars
JWT_REFRESH_EXPIRES_IN_DAYS=7
# bcrypt cost factor
BCRYPT_ROUNDS=11

# --- Crowdsourced mobility (privacy) ---
# HMAC key for daily pseudonyms. Rotating it makes every existing pseudonym unlinkable.
PSEUDONYM_SECRET=change-me-to-a-third-long-random-string-of-32-chars
# Version of the mobility data policy users consent to (bump when the text changes)
MOBILITY_POLICY_VERSION=2026-11-v1

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Seed ---
# Password for all demo accounts created by npm run db:seed
SEED_PASSWORD=change-me-demo-password
# Seed for the deterministic random generator (synthetic mobility data)
SEED_RANDOM=20261119

# --- External AI services (optional; empty = features fall back gracefully) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_API_URL=https://api.cartesia.ai
CARTESIA_VERSION=2026-08-14
# Voice ids from the Cartesia voice library. A language without a voice uses CARTESIA_VOICE_ID;
# with neither, the client falls back to the browser voice (speechSynthesis).
CARTESIA_VOICE_ID=
CARTESIA_VOICE_ID_AR=
CARTESIA_VOICE_ID_FR=
CARTESIA_VOICE_ID_EN=
CARTESIA_STT_MODEL=ink-2