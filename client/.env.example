# Where the Vite dev server proxies /api, /health and /socket.io
API_PROXY_TARGET=http://localhost:4000

# Optional. Campus grid georeference for outdoor satellite positioning: "lat,lng,rotationDeg"
# of the point x = 0, y = 0 (local metres, x → east). Empty = indoor positioning only (QR / manual).
VITE_CAMPUS_GEOREF=
# Demos only: also send simulated positions to the anonymous mobility log (never in production).
VITE_LOG_SIMULATED_POSITIONS=false
# Optional override for the login-page demo quick-fill. By default Vite reads
# SEED_PASSWORD from ../server/.env so the two stay in sync.
VITE_DEMO_PASSWORD=
