ACCESU_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESU_BUILDINGS_FILE=examples/demo_building.json
DATABASE_URL=postgresql://accesu:accesu_dev_only@localhost:5432/accesu_test
API_VERSION=v1
AI_RATE_LIMIT_PER_MINUTE=120
# Versioned API keys are stored as hashes in PostgreSQL.

# Generate independent random values for each deployment; never commit real secrets.
ACCESU_SERVICE_TOKEN=
ACCESU_ADMIN_TOKEN=
ACCESU_CONTRIBUTOR_HASH_SECRET=
ACCESU_CONSENT_VERSION=consent-v1

# Voluntary analytics policy (defaults shown).
ACCESU_ANALYTICS_RETENTION_HOURS=24
ACCESU_SESSION_MAX_HOURS=2
ACCESU_MAX_SHARING_HOURS=24
ACCESU_MIN_SESSIONS_PER_GROUP=20
ACCESU_MIN_CONTRIBUTORS_PER_GROUP=5
ACCESU_DISPARITY_RATIO=1.5
ACCESU_MIN_DURATION_DIFFERENCE_SECONDS=180
ACCESU_CONSISTENCY_FRACTION=0.7
